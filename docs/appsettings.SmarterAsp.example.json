{
  "ConnectionStrings": {
    "NoName_HotelDbConnectionString": "Server=YOUR_SQL_SERVER;Database=YOUR_DATABASE;User Id=YOUR_DATABASE_USER;Password=REPLACE_WITH_DATABASE_PASSWORD;Encrypt=True;TrustServerCertificate=False;"
  },
  "JwtSettings": {
    "Issuer": "NoName_Hotel",
    "Audience": "NoName_HotelClient",
    "DurationInMinutes": 10,
    "key": "REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG"
  },
  "Monitoring": {
    "EnableHealthChecksUI": false
  },
  "PasswordReset": {
    "FrontendUrl": "https://YOUR_PUBLIC_HOTEL_SITE"
  },
  "HotelMail": {
    "Host": "YOUR_SMTP_HOST",
    "Port": 587,
    "EnableSsl": true,
    "From": "YOUR_VERIFIED_SENDER_ADDRESS",
    "Username": "YOUR_SMTP_USERNAME",
    "Password": "REPLACE_WITH_SMTP_PASSWORD"
  }
}
